---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="th">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="lab">
			<!-- ── Signature: host manifest ── -->
			<section class="manifest" aria-label="host manifest">
				<div class="manifest__bar">
					<span class="tag">// host manifest</span>
					<span class="status"><span class="dot" aria-hidden="true"></span>ONLINE</span>
				</div>

				<h1 class="node">
					043009700<span class="tld">.xyz</span><span class="cursor" aria-hidden="true">_</span>
				</h1>

				<p class="mission">
					ห้องแล็บส่วนตัวสำหรับ <strong>ทดสอบและทดลองด้าน Cybersecurity</strong> —
					พื้นที่ปิดเอาไว้หัดเจาะ หัดป้องกัน รันเครื่องมือ และจดบันทึกทุกอย่างที่ได้เรียนรู้
					ก่อนจะเอาไปใช้กับงานจริงอย่างมีความรับผิดชอบ
				</p>

				<dl class="specs">
					<div>
						<dt>purpose</dt>
						<dd>security research &middot; learning</dd>
					</div>
					<div>
						<dt>scope</dt>
						<dd>authorized targets only</dd>
					</div>
					<div>
						<dt>uptime</dt>
						<dd>always under construction</dd>
					</div>
				</dl>
			</section>

			<!-- ── สิ่งที่อยู่ในแล็บ ── -->
			<section class="modules" aria-label="what lives here">
				<article class="card">
					<span class="card__label">[ notes ]</span>
					<h2>Writeups &amp; Lab Notes</h2>
					<p>
						บันทึกการทดลอง — CTF, machine ที่ลองเจาะ, ช่องโหว่ที่เจอ
						และวิธีคิดทีละขั้นแบบละเอียด เพื่อกลับมาอ่านซ้ำได้
					</p>
				</article>

				<article class="card">
					<span class="card__label">[ tooling ]</span>
					<h2>Tooling &amp; Recon</h2>
					<p>
						รวมสคริปต์ คำสั่ง และ workflow ที่ใช้บ่อยในการทำ recon,
						enumeration และวิเคราะห์ผล ให้หยิบใช้ซ้ำได้เร็ว
					</p>
				</article>

				<article class="card">
					<span class="card__label">[ range ]</span>
					<h2>Sandbox Range</h2>
					<p>
						สนามทดสอบที่ตั้งขึ้นเอง — เครื่องเป้าหมาย, container
						และ environment ที่ควบคุมได้เต็มที่ ไม่แตะระบบของใครโดยไม่ได้รับอนุญาต
					</p>
				</article>
			</section>

			<!-- ── ขอบเขต / disclaimer ── -->
			<section class="rules" aria-label="rules of engagement">
				<span class="tag">// rules of engagement</span>
				<h2>ทดสอบอย่างมีขอบเขต</h2>
				<ul>
					<li>
						เนื้อหาทั้งหมดในเว็บนี้มีไว้เพื่อ <strong>การศึกษาและการทดสอบที่ได้รับอนุญาต</strong> เท่านั้น
					</li>
					<li>
						ทดสอบเฉพาะระบบที่ตัวเองเป็นเจ้าของ หรือได้รับอนุญาตเป็นลายลักษณ์อักษรเท่านั้น
					</li>
					<li>
						พบช่องโหว่ในระบบผู้อื่น → รายงานตามหลัก <strong>responsible disclosure</strong> ไม่นำไปใช้ในทางที่ผิด
					</li>
					<li>
						ผู้เขียนไม่รับผิดชอบต่อการนำข้อมูลไปใช้ผิดวัตถุประสงค์หรือผิดกฎหมาย
					</li>
				</ul>
			</section>

			<p class="prompt" aria-hidden="true">
				<span class="prompt__sign">root@043009700</span>:<span class="prompt__path">~</span>$
				<span class="prompt__cmd">whoami</span>
			</p>
		</main>
		<Footer />

		<style is:global>
			/* ธีมรวมของหน้า เพื่อให้ Header/Footer เข้ากับพื้นเข้ม */
			body {
				background-color: #0b0e14;
				color: #c9d1d9;
			}
			body a {
				color: #ffb454;
			}
		</style>

		<style>
			.lab {
				--bg: #0b0e14;
				--surface: #12161f;
				--line: #1e2530;
				--ink: #c9d1d9;
				--muted: #6b7684;
				--signal: #ffb454;
				--ok: #4d9375;
				--mono: ui-monospace, 'SFMono-Regular', 'JetBrains Mono', 'Cascadia Code',
					Menlo, Consolas, monospace;
				--sans: system-ui, -apple-system, 'Segoe UI', 'Noto Sans Thai', sans-serif;

				max-width: 860px;
				margin: 0 auto;
				padding: 0 20px 64px;
				color: var(--ink);
				font-family: var(--sans);
				line-height: 1.7;
			}

			.tag {
				font-family: var(--mono);
				font-size: 0.8rem;
				letter-spacing: 0.04em;
				color: var(--muted);
			}

			/* ── manifest ── */
			.manifest {
				position: relative;
				margin: 8px 0 56px;
				padding: 28px clamp(20px, 5vw, 40px) 32px;
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 10px;
				background-image: linear-gradient(var(--line) 1px, transparent 1px),
					linear-gradient(90deg, var(--line) 1px, transparent 1px);
				background-size: 32px 32px;
				background-blend-mode: soft-light;
				overflow: hidden;
			}
			.manifest::before {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(
					120% 80% at 0% 0%,
					rgba(255, 180, 84, 0.06),
					transparent 60%
				);
				pointer-events: none;
			}
			.manifest__bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 22px;
			}
			.status {
				font-family: var(--mono);
				font-size: 0.78rem;
				letter-spacing: 0.12em;
				color: var(--ok);
				display: inline-flex;
				align-items: center;
				gap: 8px;
			}
			.dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--ok);
				box-shadow: 0 0 0 0 rgba(77, 147, 117, 0.6);
				animation: pulse 2.4s ease-out infinite;
			}
			.node {
				margin: 0;
				font-family: var(--mono);
				font-weight: 700;
				font-size: clamp(2.4rem, 9vw, 4.6rem);
				letter-spacing: -0.02em;
				line-height: 1;
				color: #fff;
			}
			.tld {
				color: var(--signal);
			}
			.cursor {
				color: var(--signal);
				font-weight: 400;
				animation: blink 1.1s step-end infinite;
			}
			.mission {
				max-width: 62ch;
				margin: 22px 0 28px;
				color: var(--ink);
			}
			.mission strong {
				color: #fff;
			}
			.specs {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
				gap: 1px;
				margin: 0;
				background: var(--line);
				border: 1px solid var(--line);
				border-radius: 8px;
				overflow: hidden;
			}
			.specs > div {
				background: var(--bg);
				padding: 14px 16px;
			}
			.specs dt {
				font-family: var(--mono);
				font-size: 0.72rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--muted);
			}
			.specs dd {
				margin: 4px 0 0;
				font-family: var(--mono);
				font-size: 0.9rem;
				color: var(--ink);
			}

			/* ── modules ── */
			.modules {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 16px;
				margin-bottom: 56px;
			}
			.card {
				padding: 22px 20px 24px;
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 10px;
				transition: border-color 0.2s ease, transform 0.2s ease;
			}
			.card:hover {
				border-color: var(--signal);
				transform: translateY(-3px);
			}
			.card__label {
				font-family: var(--mono);
				font-size: 0.78rem;
				letter-spacing: 0.04em;
				color: var(--signal);
			}
			.card h2 {
				margin: 12px 0 8px;
				font-size: 1.15rem;
				color: #fff;
			}
			.card p {
				margin: 0;
				font-size: 0.94rem;
				color: var(--muted);
			}

			/* ── rules ── */
			.rules {
				padding: 28px clamp(20px, 5vw, 36px) 8px;
				border-left: 2px solid var(--signal);
				background: linear-gradient(90deg, rgba(255, 180, 84, 0.04), transparent 70%);
			}
			.rules h2 {
				margin: 10px 0 16px;
				font-size: 1.4rem;
				color: #fff;
			}
			.rules ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.rules li {
				position: relative;
				margin-bottom: 12px;
				padding-left: 26px;
				color: var(--ink);
			}
			.rules li::before {
				content: '→';
				position: absolute;
				left: 0;
				color: var(--signal);
				font-family: var(--mono);
			}
			.rules strong {
				color: #fff;
			}

			/* ── prompt line ── */
			.prompt {
				margin: 48px 0 0;
				font-family: var(--mono);
				font-size: 0.9rem;
				color: var(--muted);
			}
			.prompt__sign {
				color: var(--ok);
			}
			.prompt__path {
				color: var(--signal);
			}
			.prompt__cmd {
				color: var(--ink);
			}

			@keyframes blink {
				50% {
					opacity: 0;
				}
			}
			@keyframes pulse {
				0% {
					box-shadow: 0 0 0 0 rgba(77, 147, 117, 0.5);
				}
				70% {
					box-shadow: 0 0 0 7px rgba(77, 147, 117, 0);
				}
				100% {
					box-shadow: 0 0 0 0 rgba(77, 147, 117, 0);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.cursor,
				.dot,
				.card {
					animation: none;
					transition: none;
				}
			}
		</style>
	</body>
</html>
